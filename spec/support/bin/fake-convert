#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Convertisseur de substitution des specs : écrit un petit PDF là où l'outil
# réel l'écrirait : `--outdir` de soffice, `-o`, ou second argument de
# partiduo-modeles-pdf (`entrée sortie`), à partir du fichier d'entrée.
out=""
outdir=""
input=""
second=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift ;;
    --outdir) outdir="$2"; shift ;;
    *) if [ -z "$input" ]; then input="$1"; else second="$1"; fi ;;
  esac
  shift
done
if [ -z "$out" ] && [ -z "$outdir" ] && [ -n "$second" ]; then
  out="$second"
elif [ -z "$out" ]; then
  [ -n "$second" ] && input="$second"
  base=$(basename "$input")
  out="$outdir/${base%.*}.pdf"
fi
printf '%%PDF-1.4\n%% %s\n%%%%EOF\n' "$(wc -c < "$input" | tr -d ' ')" > "$out"
